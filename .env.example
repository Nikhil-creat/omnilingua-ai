# The static/GitHub Pages build needs NO env file: paste your key in Settings (AES-GCM encrypted in your browser).
# Auto-detected key formats: gsk_ (Groq) | sk-ant- (Anthropic) | sk-or- (OpenRouter) | AIza (Gemini) | xai- (xAI) | sk- (OpenAI)
# Only for a future server/Next.js port:
LLM_API_KEY=
LLM_PROVIDER=auto
DEFAULT_MODEL=
RATE_LIMIT_RPM=30
VECTOR_DIM=256
